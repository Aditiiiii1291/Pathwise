# =============================================================================
# PATHWISE INSTITUTIONAL PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# --- Backend Database ---
# Local Development (Default SQLite):
DATABASE_URL=sqlite:///./pathwise.db
# Production (Render PostgreSQL - supplied via hosting environment):
# DATABASE_URL=postgresql://<username>:<password>@<hostname>:<port>/<database_name>

# --- Security & JWT Authentication (Phase 16) ---
# Generate a secure 64-byte key using: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_at_least_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS Allowed Origins (Comma-separated list) ---
# In production, set to your deployed frontend domain(s)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Server Port (Render sets this dynamically) ---
PORT=8000

# --- Optional SMTP Alerts (Phase 13) ---
# If left blank, Pathwise operates in local in-app notification mode only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@pathwise.edu

# --- Frontend Client Configuration ---
# Set to your backend API URL. Default for local development is http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000
