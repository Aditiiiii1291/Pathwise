# Database Configuration
DATABASE_URL=sqlite:///./pathwise.db

# JWT Authentication (Phase 16)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional SMTP Email Alerts (Phase 13)
# If not configured, Pathwise operates in local in-app notification mode only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@pathwise.edu
